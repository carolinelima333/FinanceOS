# Porta do servidor Express (uso local apenas — Vercel ignora)
PORT=3001

# URL do projeto Supabase
SUPABASE_URL=https://<seu-projeto>.supabase.co

# Chave de serviço do Supabase (nunca expor ao browser!)
SUPABASE_SERVICE_ROLE_KEY=

# Origem permitida pelo CORS (URL do frontend em produção)
CORS_ORIGIN=http://localhost:5173

# --- E-mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=FinanceOS <seu-email@gmail.com>
